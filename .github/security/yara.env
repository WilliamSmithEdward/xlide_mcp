# The YARA-X scanner and the YARA Forge rules the Security workflow scans with,
# each an exact release checked against the SHA-256 GitHub records for its
# asset: gh api repos/<owner>/<repo>/releases/tags/<tag> --jq '.assets[].digest'.
#
# YARA_FORGE_*: moved by the YARA Forge update workflow, weekly, in a pull
# request the Security workflow scans before it is merged.
# YARA_X_*: no updater follows a release download. To move it, take a release
# of VirusTotal/yara-x at least a week old and its
# yara-x-<tag>-x86_64-unknown-linux-gnu.tar.gz digest from the command above.
YARA_X_VERSION=v1.20.0
YARA_X_SHA256=cabb8df46492fff59c51261302c71ed9cb2cef393d3f0ca560801a34a8e24cbe
YARA_FORGE_RELEASE=20260920
YARA_FORGE_SHA256=24673112528aa93e13d5375312732cc2113bf4efdb8cd85f33aaeaebada35951
