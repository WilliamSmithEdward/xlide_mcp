      "fixture": "plain_workbook"
    },
    {
      "id": "power-query.read-and-write",
      "why": "M is code, edited the way VBA is.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_query",
          "arguments": {
            "file_path": "${fixture}",
            "action": "set",
            "query_name": "Numbers",
            "formula": "let Source = {1..20} in Source"
          }
        },
        {
          "tool": "xlide_read_query",
          "arguments": {
            "file_path": "${fixture}",
            "query_name": "numbers"
          }
        }
      ],
      "fixture": "plain_workbook",
      "expect": [
        {
          "path": "query",
          "equals": "Numbers"
        },
        {
          "path": "formula",
          "contains": "{1..20}"
        }
      ]
    },
    {
      "id": "power-query.a-query-loading-nowhere-has-no-refresh-settings",
      "why": "Refresh settings belong to a connection, and a query that loads nowhere has none. An implementation that treats this as an error fails on the common case.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_query",
          "arguments": {
            "file_path": "${fixture}",
            "query_name": "Numbers"
          }
        }
      ],
      "fixture": "plain_workbook",
      "expect": [
        {
          "path": "refresh_note",
          "contains": "loads nowhere"
        }
      ]
    },
    {
      "id": "power-query.refused-on-another-host",
      "why": "Power Query is an Excel feature. A Word file asking for it gets a refusal that names the host, not an empty list that reads as 'this document has no queries'.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_list_queries",
          "arguments": {
            "file_path": "${fixture}"
          },
          "error_contains": "Excel packages"
        }
      ],
      "fixture": "word_document"
    },
    {
      "id": "export.previews-before-it-writes",
      "why": "An export that silently overwrote a folder of reviewed files would lose the diff before anyone noticed.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_export_modules",
          "arguments": {
            "file_path": "${fixture}",
            "export_folder": "${folder:vba}"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "applied",
          "equals": false
        },
        {
          "path": "plan",
          "at_least": 1
        }
      ]
    },
    {
      "id": "import.previews-before-it-writes",
      "why": "The rule agents get wrong most often stated as a guard: an import reports what it would change and writes nothing, so an edited export is still only a copy until someone applies it deliberately.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_export_modules",
          "arguments": {
            "file_path": "${fixture}",
            "export_folder": "${folder:vba}",
            "apply": true
          }
        },
        {
          "tool": "xlide_import_modules",
          "arguments": {
            "file_path": "${fixture}",
            "source_folder": "${folder:vba}"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "applied",
          "equals": false
        },
        {
          "path": "plan",
          "at_least": 1
        }
      ]
    },
    {
      "id": "workspace.refuses-a-path-outside-the-roots",
      "why": "A path argument is untrusted input. Reach is bounded by configuration, not by what the caller asks for.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_list_modules",
          "arguments": {
            "file_path": "${outside}/elsewhere.xlsm"
          },
          "error_contains": "outside this server's workspace"
        }
      ]
    },
    {
      "id": "workspace.refuses-traversal-out-of-a-root",
      "why": "The same boundary, reached the other way.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_list_modules",
          "arguments": {
            "file_path": "${fixture}/../../elsewhere.xlsm"
          },
          "error_contains": "outside this server's workspace"
        }
      ],
      "fixture": "workbook"
    }
  ]
}
