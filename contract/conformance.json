      "steps": [
        {
          "tool": "xlide_delete_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "ThisWorkbook"
          },
          "error_contains": "document module"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "rename-module.refuses-a-name-that-collides-without-case",
      "why": "VBA compares without case, so Helpers and HELPERS are one name.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_rename_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers",
            "new_name": "HELPERS"
          },
          "error_contains": "already exists"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "delete-module.removes-it",
      "why": "A delete is reported by name, with what it cost.",
