    {
      "id": "analyze.reports-a-clean-file-as-clean",
      "why": "The build gate is only usable if a clean file comes back clean.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_analyze",
          "arguments": {
            "file_path": "${fixture}"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "counts.error",
          "equals": 0
        },
        {
          "path": "verdict",
          "equals": "clean"
        }
      ]
    },
    {
      "id": "analyze.positions-match-what-a-read-returns",
      "why": "The most consequential rule in the whole surface. Analysis measures a source that carries the attribute header; a read strips it. An implementation that does not shift the position reports every diagnostic one line late, and an agent acting on it edits the wrong line.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Broken",
            "source": "Option Explicit\r\n\r\nPublic Sub Broken()\r\n    Dim n As Long\r\n    n = \"not a number\"\r\nEnd Sub\r\n"
          }
        },
        {
          "tool": "xlide_analyze",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Broken",
            "min_severity": "error"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "problems",
          "at_least": 1
        },
        {
          "path": "problems[0].severity",
          "equals": "error"
        },
        {
          "path": "problems[0].line",
          "equals": 5
        },
        {
          "path": "problems[0].text",
          "contains": "not a number"
        },
        {
          "path": "verdict",
          "equals": "errors found"
        }
      ]
    },
    {
      "id": "analyze.counts-stay-project-wide-when-a-module-is-named",
      "why": "Narrowing the report must not hide from the agent that the file is not clean.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Broken",
            "source": "Option Explicit\r\n\r\nPublic Sub Broken()\r\n    Dim n As Long\r\n    n = \"not a number\"\r\nEnd Sub\r\n"
          }
        },
        {
          "tool": "xlide_analyze",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "counts.error",
          "at_least": 1
        },
        {
          "path": "verdict",
          "equals": "errors found"
        }
      ]
    },
    {
      "id": "analyze-source.needs-no-file",
      "why": "Checking generated code before writing it costs nothing and catches the compile errors that would otherwise surface in front of the user.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_analyze_source",
          "arguments": {
            "source": "Option Explicit\r\n\r\nPublic Sub Broken()\r\n    Dim n As Long\r\n    n = \"not a number\"\r\nEnd Sub\r\n",
            "host": "excel"
          }
        }
      ],
      "expect": [
        {
          "path": "verdict",
          "equals": "errors found"
        },
        {
          "path": "counts.error",
          "at_least": 1
        }
      ]
    },
    {
      "id": "analyze-source.against-a-project-resolves-its-calls",
      "why": "A draft module that calls into the project must resolve against it, or every check of new code drowns in names it cannot see.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_analyze_source",
          "arguments": {
            "source": "Option Explicit\r\n\r\nPublic Sub Use()\r\n    Debug.Print AddNums(1, 2)\r\nEnd Sub\r\n",
            "module_name": "Draft",
            "file_path": "${fixture}"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "counts.error",
          "equals": 0
        },
        {
          "path": "host",
          "equals": "excel"
        }
      ]
    },
    {
      "id": "analyze.refuses-an-unknown-host",
      "why": "Only the four hosts have object models here, and a typo must not silently fall back to analyzing against nothing.",
