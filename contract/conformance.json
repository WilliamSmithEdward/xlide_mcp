{
  "conformance_version": "0.1.0",
  "reference_implementation": "python",
  "note": "Behaviour every implementation in this repository owes. The Python suite runs this file, so a case that is wrong fails there before a port ever sees it.",
  "requires": {
    "files": "Reads and writes the Office file. No Office installation, any platform.",
    "office": "Runs VBA in a desktop application. Windows, with the application.",
    "live": "Talks to a running xlide_vbide session inside the Visual Basic Editor."
  },
  "fixtures": {
    "workbook": {
      "kind": "excel-macro-workbook",
      "file_name": "Budget.xlsm",
      "why": "A macro-enabled workbook created from the application's own template, with one standard module added. The module analyzes clean on purpose: a fixture that analyzes dirty makes every analysis case argue with the fixture.",
      "modules": [
        {
          "name": "Helpers",
          "kind": "standard",
          "source": "Option Explicit\r\n\r\nPublic Function AddNums(ByVal a As Long, ByVal b As Long) As Long\r\n    AddNums = a + b\r\nEnd Function\r\n\r\nPublic Sub Greet()\r\n    Dim who As String\r\n    who = \"world\"\r\n    Debug.Print \"hello \" & who\r\nEnd Sub\r\n"
        }
      ]
    },
    "word_document": {
      "kind": "word-document",
      "file_name": "Report.docm",
      "why": "A host that is not Excel, so the refusals that turn on which application a file belongs to have a real subject rather than a hypothetical one.",
      "modules": []
    },
    "plain_workbook": {
      "kind": "excel-workbook",
      "file_name": "Data.xlsx",
      "why": "A workbook with no VBA project at all, carrying one Power Query. It pins the rule that Power Query and worksheet cells are reachable where macros are not.",
      "power_query": [
        {
          "name": "Numbers",
          "formula": "let Source = {1..10} in Source"
        }
      ]
    }
  },
  "case_count": 36,
  "cases": [
    {
      "id": "project-info.reports-the-write-guards",
      "why": "Before writing, an agent has to know whether the project is protected or signed. Both facts are present and false on an ordinary file, never merely absent.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_project_info",
          "arguments": {
            "file_path": "${fixture}"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "host",
          "equals": "excel"
        },
        {
          "path": "vba_readable",
          "equals": true
        },
        {
          "path": "password_protected",
          "equals": false
        },
        {
          "path": "digitally_signed",
          "equals": false
        },
        {
          "path": "modules",
          "at_least": 1
        }
      ]
    },
    {
      "id": "read-module.strips-the-attribute-header",
      "why": "A read returns what the VBA editor shows. The Attribute VB_* header is managed for the caller, and an agent that edits it by hand breaks a module's binding.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "module",
          "equals": "Helpers"
        },
        {
          "path": "kind",
          "equals": "standard"
        },
        {
          "path": "source",
          "not_contains": "Attribute VB_Name"
        },
        {
          "path": "source",
          "contains": "Public Function AddNums"
        },
        {
          "path": "content_token",
          "starts_with": "xlide1:"
        }
      ]
    },
    {
      "id": "read-module.include-header-shows-it",
      "why": "The header is reachable when it is genuinely wanted, so the default hiding it costs nothing.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers",
            "include_header": true
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "source",
          "contains": "Attribute VB_Name"
        }
      ]
    },
    {
      "id": "module-names.match-without-case",
      "why": "VBA compares names without case, so every tool that takes a module name does too.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "hELPers"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "module",
          "equals": "Helpers"
        }
      ]
    },
    {
      "id": "read-module.missing-names-what-exists",
      "why": "A refusal that lists the modules that do exist saves the round trip an agent would otherwise spend discovering them.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Nope"
          },
          "error_contains": "Helpers"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "list-procedures.joins-a-continued-signature",
      "why": "A declaration split over lines with trailing underscores is one procedure. Reporting it as several is worse than reporting none.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Wrapped",
            "source": "Option Explicit\r\n\r\nPublic Function Pair(ByVal a As Long, _\r\n                     ByVal b As Long) As Long\r\n    Pair = a + b\r\nEnd Function\r\n"
          }
        },
        {
          "tool": "xlide_list_procedures",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Wrapped"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "procedures",
          "at_least": 1
        },
        {
          "path": "procedures[0].name",
          "equals": "Pair"
        },
        {
          "path": "procedures[0].kind",
          "equals": "Function"
        }
      ]
    },
    {
      "id": "write-module.round-trips-and-reissues-the-token",
      "why": "A write answers with the token of what it wrote, so the next write can be guarded without a second read.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers"
          }
        },
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers",
            "source": "Option Explicit\r\n\r\nPublic Function AddNums(ByVal a As Long, ByVal b As Long) As Long\r\n    AddNums = a + b + 1\r\nEnd Function\r\n\r\nPublic Sub Greet()\r\n    Dim who As String\r\n    who = \"world\"\r\n    Debug.Print \"hello \" & who\r\nEnd Sub\r\n",
            "expected_content_token": "${step[0].content_token}"
          }
        },
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "source",
          "contains": "a + b + 1"
        },
        {
          "path": "content_token",
          "equals": "${step[1].content_token}"
        }
      ]
    },
    {
      "id": "write-module.refuses-a-stale-token",
      "why": "The guard that stops one writer discarding another's change. A token from a read that something else has since overtaken must refuse, and the refusal has to hand back the current token so the caller can recover in one step.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_read_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers"
          }
        },
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers",
            "source": "Option Explicit\r\n\r\nPublic Function AddNums(ByVal a As Long, ByVal b As Long) As Long\r\n    AddNums = a + b\r\nEnd Function\r\n\r\nPublic Sub Greet()\r\n    Dim who As String\r\n    who = \"world\"\r\n    Debug.Print \"hello \" & who\r\nEnd Sub\r\n' someone else got here first\r\n",
            "expected_content_token": "${step[0].content_token}"
          }
        },
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Helpers",
            "source": "Option Explicit\r\n\r\nPublic Function AddNums(ByVal a As Long, ByVal b As Long) As Long\r\n    AddNums = a + b\r\nEnd Function\r\n\r\nPublic Sub Greet()\r\n    Dim who As String\r\n    who = \"world\"\r\n    Debug.Print \"hello \" & who\r\nEnd Sub\r\n' my edit\r\n",
            "expected_content_token": "${step[0].content_token}"
          },
          "error_contains": "xlide1:"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "write-module.creates-what-is-missing",
      "why": "Creating a module is a write with no token, not a separate tool.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Fresh",
            "source": "Option Explicit\r\n"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "created",
          "equals": true
        },
        {
          "path": "kind",
          "equals": "standard"
        },
        {
          "path": "saved",
          "equals": true
        }
      ]
    },
    {
      "id": "write-module.creates-a-class-on-request",
      "why": "Class modules are created through the same tool, by kind.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Widget",
            "source": "Option Explicit\r\n",
            "kind": "class"
          }
        }
      ],
      "fixture": "workbook",
      "expect": [
        {
          "path": "created",
          "equals": true
        },
        {
          "path": "kind",
          "equals": "class"
        }
      ]
    },
    {
      "id": "write-module.refuses-an-invalid-name",
      "why": "A name VBA cannot carry is refused before the file is touched.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "1Bad",
            "source": "Option Explicit\r\n"
          },
          "error_contains": "not a valid module name"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "write-module.refuses-a-reserved-word",
      "why": "A module cannot be called Sub, whatever the caller intended.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_write_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "Sub",
            "source": "Option Explicit\r\n"
          },
          "error_contains": "reserved word"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "rename-module.refuses-a-document-module",
      "why": "The host owns ThisWorkbook and recreates it by name. A renamed one leaves the project no longer matching its file.",
      "requires": "files",
      "steps": [
        {
          "tool": "xlide_rename_module",
          "arguments": {
            "file_path": "${fixture}",
            "module_name": "ThisWorkbook",
            "new_name": "Renamed"
          },
          "error_contains": "document module"
        }
      ],
      "fixture": "workbook"
    },
    {
      "id": "delete-module.refuses-a-document-module",
      "why": "Deleting one is the same category error as renaming it.",
